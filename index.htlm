<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo Bagués</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; margin: 0; padding: 20px; background-color: #ffffff; color: #333; text-align: center; }
        header { border-bottom: 1px solid #eee; padding: 20px 0; margin-bottom: 30px; }
        h1 { font-weight: 300; text-transform: uppercase; letter-spacing: 2px; }
        .galeria { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; }
        .producto { background: #fff; border: 1px solid #f0f0f0; padding: 10px; width: 250px; border-radius: 4px; }
        img { width: 100%; height: auto; border-radius: 2px; }
        .boton-wsp { display: inline-block; margin-top: 30px; padding: 12px 25px; background-color: #25d366; color: #fff; text-decoration: none; border-radius: 50px; font-weight: bold; }
    </style>
</head>
<body>

    <header>
        <h1>Catálogo de Belleza</h1>
        <p>Fragancias y Cosmética Bagués</p>
    </header>
<div class="galeria">

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Catálogo</title>

  <style>
    body {
      font-family: Arial;
      background: #f5f5f5;
      text-align: center;
    }

    .contenedor {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .producto {
      background: white;
      margin: 10px;
      padding: 10px;
      border-radius: 10px;
      width: 200px;
    }

    img {
      width: 100%;
      border-radius: 10px;
    }
  </style>
</head>

<body>

<h1>Catálogo</h1>

<div class="contenedor">

  <div class="producto">
    <img src="Aromatizantes_Higos_y_Matcha.png">
  </div>

  <div class="producto">
    <img src="Aromatizantes_Orientales.png">
  </div>

  <div class="producto">
    <img src="Difusor_y_Aromatizante_Lino.png">
  </div>

</div>

</body>
</html>
